<section id="contents">
  <h2 class="project-title">MY PROJECT</h2>

  <div
    class="filter-container"
    style="display: flex; justify-content: center; margin-bottom: 30px;"
  >
    <input type="text" id="filterInput" placeholder="Search projects..." />
  </div>

  <div class="project-grid">
    {{#each projects}}
      <div class="project-card">
        {{! Bungkus gambar dengan link ke detail }}
        <a href="/project-detail/{{this.id}}">
          <img src="/assets/img/{{this.image}}" alt="{{this.title}}" />
        </a>

        <div class="project-info">
          {{! Judul mengarah ke detail }}
          <a
            href="/project-detail/{{this.id}}"
            style="text-decoration: none; color: inherit;"
          >
            <h3 class="project-item-title">{{this.title}}</h3>
          </a>

          {{! Menampilkan Nama Author jika ada (Hasil JOIN SQL) }}
          <p
            class="author-text"
            style="font-size: 12px; color: #666; margin-bottom: 5px;"
          >
            <i class="fa-solid fa-user"></i>
            {{this.author_name}}
          </p>

          {{! Ganti 'Durasi' menjadi 'Duration' }}
          <p class="project-duration">Duration: {{this.duration}}</p>

          {{! Memotong text deskripsi agar tidak terlalu panjang di card }}
          <p
            class="content-text"
            style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;"
          >
            {{this.content}}
          </p>

          <div
            class="tech-icons"
            style="margin: 10px 0; display: flex; gap: 5px; flex-wrap: wrap;"
          >
            {{#each this.technologies}}
              <span
                class="badge text-bg-secondary"
                style="background-color: #444; color: white; padding: 5px 10px; border-radius: 5px; font-size: 10px;"
              >
                {{this}}
              </span>
            {{/each}}
          </div>

          <div class="btn-group">
            <a href="/edit-project/{{this.id}}" class="btn-edit">Edit</a>
            <a href="/delete-project/{{this.id}}" class="btn-delete">Delete</a>
          </div>
        </div>
      </div>
    {{/each}}
  </div>
</section>