<div class="container-detail">
  <h1 class="title">{{project.title}}</h1>

  <div class="detail-content">
    <div class="detail-left">
      <img src="/assets/img/{{project.image}}" alt="{{project.title}}" />
    </div>

    <div class="detail-right">
      {{! English labels for consistency }}
      <h3>Duration</h3>

      <div class="info-item">
        <i class="fa-solid fa-calendar-days"></i>
        {{! Using formatInputDate helper here makes the display cleaner }}
        <span>{{formatInputDate project.start_date}}
          -
          {{formatInputDate project.end_date}}</span>
      </div>

      <div class="info-item">
        <i class="fa-solid fa-clock"></i>
        {{! Shows the calculated string like "Less than a day" or "X months" }}
        <span>{{project.duration}}</span>
      </div>

      <h3 style="margin-top: 30px;">Technologies</h3>
      <div class="detail-tech">
        {{#each project.technologies}}
          <div class="tech-item">
            <span>{{this}}</span>
          </div>
        {{/each}}
      </div>
    </div>
  </div>

  <div class="description">
    {{! The project content/description }}
    <p>{{project.content}}</p>
  </div>
</div>