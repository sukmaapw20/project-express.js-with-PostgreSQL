<section id="contents">
  <h2 class="project-title">MY PROJECT</h2>

  <div
    class="filter-container"
    style="display: flex; justify-content: center; margin-bottom: 30px;"
  >
    <input type="text" id="filterInput" placeholder="Search projects..." />
  </div>

  <div class="project-grid">
    {{#each projects}}
      <div class="project-card">
        {{! 1. Perbaiki Path Gambar: Sesuaikan dengan folder tempat kamu menyimpan foto }}
        <img src="/assets/img/{{this.image}}" alt="{{this.title}}" />

        <div class="project-info">
          <a
            href="/project-detail/{{this.id}}"
            style="text-decoration: none; color: inherit;"
          >
            <h3>{{this.title}}</h3>
          </a>

          <p class="duration">Durasi: {{this.duration}}</p>
          <p class="content-text">{{this.content}}</p>

          {{! 2. WAJIB: Tambahkan loop untuk menampilkan Technologies }}
          <div
            class="tech-icons"
            style="margin: 10px 0; display: flex; gap: 5px;"
          >
            {{#each this.technologies}}
              <span
                class="badge text-bg-secondary"
                style="background-color: #444; color: white; padding: 5px 10px; border-radius: 5px; font-size: 12px;"
              >
                {{this}}
              </span>
            {{/each}}
          </div>

          <div class="btn-group">
            <a href="/edit-project/{{this.id}}" class="btn-edit">Edit</a>
            <a href="/delete-project/{{this.id}}" class="btn-delete">Delete</a>
          </div>
        </div>
      </div>
    {{/each}}
  </div>
</section>