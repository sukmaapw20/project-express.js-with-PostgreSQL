<!-- CONTACT -->
<section class="container mt-5 text-center">
  <h2>Contact Me</h2>

  <form class="col-md-4 mx-auto mt-4" action="/contact" method="POST">
    <input class="form-control mb-2" placeholder="Name" name="name" />
    <input class="form-control mb-2" placeholder="Email" name="email" />
    <input
      type="tel"
      class="form-control mb-2"
      placeholder="Phone Number"
      name="phone"
    />
    <textarea
      class="form-control mb-2"
      rows="3"
      placeholder="Message"
      name="message"
    ></textarea>
    <button class="btn btn-outline-light w-100">Send</button>
  </form>
</section>

